{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "portfolio-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start",
        "-p",
        "3300"
      ],
      "port": 3300
    },
    {
      "name": "design-boards",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4310",
        "--bind",
        "127.0.0.1",
        "--directory",
        "design"
      ],
      "port": 4310
    }
  ]
}
