{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "notification": true,
  "verbose": false,
  "autoUpdate": true,
  "autoCompactThreshold": 80,
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin main)"
    ]
  }
}
