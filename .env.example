# -----------------------------------------------------------------------------
# Public. This one IS meant to be NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
#
# The origin the site describes itself as living at: metadataBase, canonical
# URLs, Open Graph, JSON-LD and the sitemap. It is printed in the page's own
# <head>, so it is not a secret, and it has to resolve identically on the
# server and in the browser — which is exactly what the prefix guarantees.
#
# Leave it unset locally. Set it on the production deployment to the real
# domain. A preview deployment that leaves it unset falls back to its own
# hostname rather than claiming to be production. See src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# Server-only. Contact delivery.
# -----------------------------------------------------------------------------
#
# Do NOT prefix any of these with NEXT_PUBLIC_ — that would
# ship them into the client bundle. They are read once, on the server, in
# src/app/page.tsx, and only a derived boolean ever crosses to the client.
#
# When all three are set, the Contact section sends messages through
# Resend. When any one of them is missing, Contact falls back to an
# "open the visitor's email app" (mailto:) flow instead — the site is
# fully functional either way.

# API key for the Resend account used to send contact-form messages.
RESEND_API_KEY=

# Inbox address that contact-form submissions are delivered to.
CONTACT_TO_EMAIL=

# Verified "from" address Resend sends contact-form messages on behalf of.
CONTACT_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Server-only. "Ask this site" live mode (AI Workflow Lab).
# -----------------------------------------------------------------------------
#
# Do NOT prefix any of these with NEXT_PUBLIC_ — ASK_LLM_API_KEY especially
# must never ship into the client bundle. They are read once, on the server,
# in src/sections/AIWorkflowLab/AIWorkflowLab.tsx and independently
# re-checked in src/app/api/ask/route.ts, and only a derived boolean ever
# crosses to the client — the same Resend→mailto shape Contact uses above.
#
# "Ask this site" always works with none of these set: a lexical index over
# the page's own content answers instantly, offline, for free. Setting all
# of ASK_LLM_API_KEY and ASK_LLM_MODEL turns on a second, live mode instead —
# the same retrieval, handed to a real model over one plain `fetch` call (no
# SDK) to compose a short answer from the retrieved passages and nothing
# else. Leave these unset unless you want that model call to happen, since
# every grounded question then costs a real API call.

# API key for an OpenAI-compatible chat-completions endpoint.
ASK_LLM_API_KEY=

# Model name to send in the request body, e.g. "gpt-4o-mini".
ASK_LLM_MODEL=

# Optional. Defaults to https://api.openai.com/v1/chat/completions when
# unset — set this to point at a different OpenAI-compatible provider.
ASK_LLM_URL=
