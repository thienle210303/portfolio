# -----------------------------------------------------------------------------
# Public. This one IS meant to be NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
#
# The origin the site describes itself as living at: metadataBase, canonical
# URLs, Open Graph, JSON-LD and the sitemap. It is printed in the page's own
# <head>, so it is not a secret, and it has to resolve identically on the
# server and in the browser — which is exactly what the prefix guarantees.
#
# Leave it unset locally. Set it on the production deployment to the real
# domain. A preview deployment that leaves it unset falls back to its own
# hostname rather than claiming to be production. See src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# Server-only. Contact delivery.
# -----------------------------------------------------------------------------
#
# Do NOT prefix any of these with NEXT_PUBLIC_ — that would
# ship them into the client bundle. They are read once, on the server, in
# src/app/page.tsx, and only a derived boolean ever crosses to the client.
#
# When all three are set, the Contact section sends messages through
# Resend. When any one of them is missing, Contact falls back to an
# "open the visitor's email app" (mailto:) flow instead — the site is
# fully functional either way.

# API key for the Resend account used to send contact-form messages.
RESEND_API_KEY=

# Inbox address that contact-form submissions are delivered to.
CONTACT_TO_EMAIL=

# Verified "from" address Resend sends contact-form messages on behalf of.
CONTACT_FROM_EMAIL=
