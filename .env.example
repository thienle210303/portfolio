# -----------------------------------------------------------------------------
# Public. This one IS meant to be NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
#
# The origin the site describes itself as living at: metadataBase, canonical
# URLs, Open Graph, JSON-LD and the sitemap. It is printed in the page's own
# <head>, so it is not a secret, and it has to resolve identically on the
# server and in the browser — which is exactly what the prefix guarantees.
#
# Leave it unset locally. Set it on the production deployment to the real
# domain. A preview deployment that leaves it unset falls back to its own
# hostname rather than claiming to be production. See src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# Server-only. Contact delivery.
# -----------------------------------------------------------------------------
#
# Do NOT prefix any of these with NEXT_PUBLIC_ — that would
# ship them into the client bundle. They are read once, on the server, in
# src/app/page.tsx, and only a derived boolean ever crosses to the client.
#
# When all three are set, the postcard's lead form (a name plus an email or
# phone) posts to /api/contact, which sends it through Resend straight to
# CONTACT_TO_EMAIL, with the visitor's email as the reply-to. When any one of
# them is missing, or a send fails, the form says so in my voice and shows my
# address with a copy button. It never opens the visitor's email app.
#
# These are read at BUILD time: page.tsx turns them into one boolean that the
# form is rendered with. Adding or changing RESEND_API_KEY on Vercel does
# nothing until you REDEPLOY (the route re-checks them at request time, but the
# page would still be showing the "cannot send" form).
#
# Resend's shared sender, onboarding@resend.dev, only delivers to the address
# the Resend account was created with, so CONTACT_TO_EMAIL must be that one
# until a domain is verified in Resend.

# API key for the Resend account used to send leads.
RESEND_API_KEY=

# Inbox address that leads are delivered to.
CONTACT_TO_EMAIL=

# Verified "from" address Resend sends leads on behalf of.
CONTACT_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Server-only. "Ask this site" live mode.
# -----------------------------------------------------------------------------
#
# Do NOT prefix any of these with NEXT_PUBLIC_ — ASK_LLM_API_KEY especially
# must never ship into the client bundle. They are read once, on the server,
# in src/app/page.tsx and independently re-checked in
# src/app/api/ask/route.ts, and only a derived boolean ever crosses to the
# client — the same Resend→mailto shape Contact uses above.
#
# "Ask this site" always works with none of these set: a lexical index over
# the page's own content answers instantly, offline, for free. Setting all
# of ASK_LLM_API_KEY and ASK_LLM_MODEL turns on a second, live mode instead —
# the same retrieval, handed to a real model over one plain `fetch` call (no
# SDK) to compose a short answer from the retrieved passages and nothing
# else. Leave these unset unless you want that model call to happen, since
# every grounded question then costs a real API call.

# API key for an OpenAI-compatible chat-completions endpoint.
ASK_LLM_API_KEY=

# Model name to send in the request body, e.g. "gpt-4o-mini".
ASK_LLM_MODEL=

# Optional. Defaults to https://api.openai.com/v1/chat/completions when
# unset — set this to point at a different OpenAI-compatible provider.
ASK_LLM_URL=

# -----------------------------------------------------------------------------
# Booking link. Read on the server, but NOT a secret.
# -----------------------------------------------------------------------------
#
# Read once, on the server, in src/app/page.tsx, then printed in the page as a
# link, so every visitor can read it: put nothing here you would not publish.
# (It has no NEXT_PUBLIC_ prefix because only the server reads it.) Optional: a
# scheduling URL (e.g. a Cal.com event) that the hero and the business card
# offer as "Book a call", a plain link in a new tab, never an embedded widget. It must be
# https:// followed by a host; when unset, empty or anything else, nothing
# renders: no link, no label.
# Like the Resend values, it is read at build time, so changing it needs a
# redeploy.
BOOKING_URL=
